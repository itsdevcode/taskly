{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taskly",
  "version": "1.0.0",
  "identifier": "com.taskly.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Taskly",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Your day, a little clearer.",
    "category": "Productivity",
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
